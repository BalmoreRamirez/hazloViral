# ─── Base de Datos ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=influsmart
DB_USERNAME=developer
DB_PASSWORD=DevPass123
NODE_ENV=development
# TRUE habilita la futura integración fiscal; FALSE mantiene comprobantes internos.
FACTURA_ELECTRONICA=FALSE
# development genera DTE simulado; production requiere integración y llaves oficiales.
DTE_MODE=development
# Configuración preparada para ambiente de pruebas MH; no se usa mientras la bandera sea FALSE.
DTE_AMBIENTE=00
DTE_FIRMADOR_URL=http://localhost:8080/firmardte/
DTE_MH_AUTH_URL=https://apifacturatest.mh.gob.sv/auth
DTE_MH_RECEPCION_URL=https://apifacturatest.mh.gob.sv/fesv/recepciondte
DTE_EMISOR_NIT=
DTE_EMISOR_NRC=
DTE_EMISOR_NOMBRE=
DTE_EMISOR_COD_ACTIVIDAD=
DTE_EMISOR_DESC_ACTIVIDAD=
DTE_EMISOR_DEPARTAMENTO=
DTE_EMISOR_MUNICIPIO=
DTE_EMISOR_DIRECCION=
DTE_EMISOR_TELEFONO=
DTE_EMISOR_CORREO=
DTE_MH_USER=
DTE_MH_PASSWORD=
DTE_FIRMADOR_NIT=
DTE_FIRMADOR_PASSWORD_PRI=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=7d

# ─── Aplicación ───────────────────────────────────────────────────────────────
APP_PORT=3009
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por HTTP y Socket.IO, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Email (SMTP) — notificaciones al tutor de menores ───────────────────────
# Dejar en blanco para omitir envío de emails (se imprimirá en consola)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM=no-reply@influsmart.com

# ─── Forma de pago: 'desarrollo' (sandbox Wompi) | 'produccion' (Wompi real) ──
FORMA_PAGO=desarrollo

# ─── Wompi — Desarrollo (Sandbox) ─────────────────────────────────────────────
# Panel: https://comercios.wompi.co → pestaña Sandbox
WOMPI_DEV_PUBLIC_KEY=pub_test_...
WOMPI_DEV_PRIVATE_KEY=prv_test_...
WOMPI_DEV_INTEGRITY_KEY=test_integrity_...
WOMPI_DEV_EVENTS_KEY=test_events_...

# ─── Wompi — Producción ────────────────────────────────────────────────────────
# Panel: https://comercios.wompi.co → pestaña Producción
WOMPI_PROD_PUBLIC_KEY=pub_prod_...
WOMPI_PROD_PRIVATE_KEY=prv_prod_...
WOMPI_PROD_INTEGRITY_KEY=prod_integrity_...
WOMPI_PROD_EVENTS_KEY=prod_events_...

# ─── Moneda ────────────────────────────────────────────────────────────────────
# Wompi, créditos, contratos, comprobantes y facturas operan en USD.

# ─── RapidAPI — Verificación automática de redes sociales ─────────────────────
# development permite registrar redes sin llamar a RapidAPI; production exige la verificación real.
SOCIAL_VERIFICATION_MODE=development
# Obtén tu key en: https://rapidapi.com → My Apps → Application Key
RAPIDAPI_KEY=tu_rapidapi_key_aqui

# Instagram Scraper Stable API → https://rapidapi.com/search/instagram-scraper-stable-api
IG_RAPIDAPI_HOST=instagram-scraper-stable-api.p.rapidapi.com
IG_RAPIDAPI_PATH=/ig_get_fb_profile_hover.php?username_or_url={u}

# TikTok API — configura según la API a la que estés suscrito en RapidAPI
# Ejemplo con tiktok-api23: https://rapidapi.com/search/tiktok-api23
TT_RAPIDAPI_HOST=tiktok-api23.p.rapidapi.com
TT_RAPIDAPI_PATH=/api/user/info?uniqueId={u}
