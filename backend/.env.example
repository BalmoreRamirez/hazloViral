# ─── Base de Datos ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=hazloViral
DB_USERNAME=developer
DB_PASSWORD=DevPass123
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=7d

# ─── Aplicación ───────────────────────────────────────────────────────────────
APP_PORT=3009
FRONTEND_URL=http://localhost:5173

# ─── Forma de pago: 'desarrollo' (sandbox Wompi) | 'produccion' (Wompi real) ──
FORMA_PAGO=desarrollo

# ─── Wompi — Desarrollo (Sandbox) ─────────────────────────────────────────────
# Panel: https://comercios.wompi.co → pestaña Sandbox
WOMPI_DEV_PUBLIC_KEY=pub_test_...
WOMPI_DEV_PRIVATE_KEY=prv_test_...
WOMPI_DEV_INTEGRITY_KEY=test_integrity_...
WOMPI_DEV_EVENTS_KEY=test_events_...

# ─── Wompi — Producción ────────────────────────────────────────────────────────
# Panel: https://comercios.wompi.co → pestaña Producción
WOMPI_PROD_PUBLIC_KEY=pub_prod_...
WOMPI_PROD_PRIVATE_KEY=prv_prod_...
WOMPI_PROD_INTEGRITY_KEY=prod_integrity_...
WOMPI_PROD_EVENTS_KEY=prod_events_...

# ─── Wompi — Conversión ───────────────────────────────────────────────────────
# 1 crédito = 1 USD. Tasa de conversión para cobrar en COP.
WOMPI_USD_TO_COP=4000

# ─── RapidAPI — Verificación automática de redes sociales ─────────────────────
# Obtén tu key en: https://rapidapi.com → My Apps → Application Key
RAPIDAPI_KEY=tu_rapidapi_key_aqui

# Instagram Scraper Stable API → https://rapidapi.com/search/instagram-scraper-stable-api
IG_RAPIDAPI_HOST=instagram-scraper-stable-api.p.rapidapi.com
IG_RAPIDAPI_PATH=/ig_get_fb_profile_hover.php?username_or_url={u}

# TikTok API — configura según la API a la que estés suscrito en RapidAPI
# Ejemplo con tiktok-api23: https://rapidapi.com/search/tiktok-api23
TT_RAPIDAPI_HOST=tiktok-api23.p.rapidapi.com
TT_RAPIDAPI_PATH=/api/user/info?uniqueId={u}
