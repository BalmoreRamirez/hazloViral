# ─── Base de Datos ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=hazloViral
DB_USERNAME=developer
DB_PASSWORD=DevPass123
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=hazloviral_secret_change_in_production
JWT_EXPIRATION=7d

# ─── Aplicación ───────────────────────────────────────────────────────────────
APP_PORT=3009
FRONTEND_URL=http://localhost:5173

# ─── Forma de pago: 'desarrollo' (sandbox) | 'produccion' (real) ──────────────
FORMA_PAGO=desarrollo

# ─── Wompi — Desarrollo (Sandbox) ─────────────────────────────────────────────
# Obtén tus llaves en: https://comercios.wompi.co → Sandbox
WOMPI_DEV_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_DEV_PRIVATE_KEY=prv_test_REEMPLAZAR
WOMPI_DEV_INTEGRITY_KEY=test_integrity_REEMPLAZAR
WOMPI_DEV_EVENTS_KEY=test_events_REEMPLAZAR

# ─── Wompi — Producción ────────────────────────────────────────────────────────
# Obtén tus llaves en: https://comercios.wompi.co → Producción
WOMPI_PROD_PUBLIC_KEY=pub_prod_REEMPLAZAR
WOMPI_PROD_PRIVATE_KEY=prv_prod_REEMPLAZAR
WOMPI_PROD_INTEGRITY_KEY=prod_integrity_REEMPLAZAR
WOMPI_PROD_EVENTS_KEY=prod_events_REEMPLAZAR

# ─── Wompi — Conversión ───────────────────────────────────────────────────────
# Tasa de conversión USD → COP (actualizar según el mercado)
WOMPI_USD_TO_COP=4000
